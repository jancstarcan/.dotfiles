{
    "layer": "top",
    "position": "top",
    "height": 24,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right": ["clock"],

    "hyprland/workspaces": {
        "all-outputs": false,
        "on-click": "activate",
        "format": "{name}"
    },

    "clock": {
        "interval": 1,
        "format": "{:%d/%m/%Y %H:%M}"
   } 
}
